<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModuloFivePadClient.DesktopClient.App"
             Name="Modulo Five Manager"
             xmlns:local="using:ModuloFivePadClient.DesktopClient"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About Modulo Five Manager…" Click="ApplicationMenuAbout_Click" />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>