<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dd="using:ModuloFivePadClient.DesktopClient.DesignArtifacts"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
        xmlns:UserControls="using:ModuloFivePadClient.DesktopClient.Views.UserControls"
        xmlns:vm="using:ModuloFivePadClient.DesktopClient.ViewModels"
        xmlns:converters="using:ModuloFivePadClient.DesktopClient.ValueConverters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        d:DataContext="{x:Static dd:DesignData.MainWindowViewModel}"
        x:Class="ModuloFivePadClient.DesktopClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="DesktopClient"
        >
    <i:Interaction.Behaviors>
        <ia:EventTriggerBehavior EventName="Opened">
            <ia:InvokeCommandAction
                Command="{Binding ReadyCommand}"
            />
        </ia:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Window.Resources>
        <converters:EqualsValueConverter x:Key="equalsValueConverter" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
        <Border Grid.Row="0" Grid.Column="0"
                BorderBrush="DarkGoldenrod"
                BorderThickness="0 0 0 4">
            <TextBlock VerticalAlignment="Bottom" Padding="12 0" FontSize="18" FontWeight="Bold" FontStyle="Italic">Menu</TextBlock>
        </Border>
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding MenuItemNames}" SelectedValue="{Binding SelectedActivity}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="12" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="0" Grid.Column="1"
                BorderBrush="DarkGoldenrod"
                BorderThickness="0 0 0 4">

            <Grid ColumnDefinitions="*,*">
                <TextBlock FontWeight="Bold" FontStyle="Italic" FontSize="24" Padding="12 12 0 0" Text="{Binding SelectedActivity}"></TextBlock>
                <ToggleButton Margin="8 0" HorizontalAlignment="Right" Grid.Column="1">Help</ToggleButton>
            </Grid>
        </Border>
        <UserControls:Welcome Padding="16" Grid.Row="1" Grid.Column="1" IsVisible="{Binding SelectedActivity, Converter={StaticResource equalsValueConverter}, ConverterParameter=Welcome}"></UserControls:Welcome>
        <!--
        - Without the null coalescing,
        -     $parent[Window]?.DataContext?.SelectedActivity
        - The introduces a transient exception:
        -     [Binding]An error occurred binding 'IsVisible' to '$parent[Window].DataContext.SelectedActivity' at 'DataContext': 'Value is null.' (MacroPadList #46496694)
        -->
        <UserControls:MacroPadList Padding="16" DataContext="{Binding MacroPadList}" Grid.Row="1" Grid.Column="1" IsVisible="{Binding $parent[Window]?.DataContext?.SelectedActivity, Converter={StaticResource equalsValueConverter}, ConverterParameter={x:Static vm:MainWindowViewModel.MENU_ITEM_NAME_MACRO_PADS}}"></UserControls:MacroPadList>
        <UserControls:BotActions Padding="16" DataContext="{Binding BotActions}" Grid.Row="1" Grid.Column="1" IsVisible="{Binding $parent[Window]?.DataContext?.SelectedActivity, Converter={StaticResource equalsValueConverter}, ConverterParameter={x:Static vm:MainWindowViewModel.MENU_ITEM_NAME_BOTS_ACTIONS}}"></UserControls:BotActions>
        <UserControls:LinkageList Padding="16" DataContext="{Binding LinkageList}" Grid.Row="1" Grid.Column="1" IsVisible="{Binding $parent[Window]?.DataContext?.SelectedActivity, Converter={StaticResource equalsValueConverter}, ConverterParameter={x:Static vm:MainWindowViewModel.MENU_ITEM_NAME_LINKAGES}}"></UserControls:LinkageList>
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock FontSize="10" FontStyle="Italic" Text="{Binding RunnerStatus}" Padding="4"></TextBlock>
        </StackPanel>
    </Grid>
</Window>
