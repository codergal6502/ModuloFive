<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="using:ModuloFivePadClient.DesktopClient.DesignArtifacts"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ModuloFivePadClient.DesktopClient.ViewModels"
             xmlns:converters="using:ModuloFivePadClient.DesktopClient.ValueConverters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             d:DataContext="{x:Static dd:DesignData.BotActionsViewModel}"
             x:Class="ModuloFivePadClient.DesktopClient.Views.UserControls.BotActions"
             x:DataType="vm:BotActionsViewModel"
             >
  <UserControl.Resources>
    <converters:IsEmptyOrWhitespace x:Key="isEmptyOrWhitespace" />
    <converters:YesNoBooleanDisplayConverter x:Key="yesNoBooleanDisplayConverter" />
  </UserControl.Resources>
  <StackPanel Orientation="Vertical">
    <Border Margin="0 0 50 0" BorderBrush="DarkGoldenrod" BorderThickness="0 0 0 4" Padding="8 8 8 0">
      <TextBlock FontWeight="DemiBold" FontSize="18">Bots</TextBlock>
    </Border>
    <StackPanel Margin="16 8 50 8" Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center" Margin="0 0 10 0" >Bot:</TextBlock>
      <ComboBox SelectedValue="{Binding SelectedBotName}" Initialized="ComboBox_Initialized" VerticalAlignment="Center" ItemsSource="{Binding BotNames}"/>
      <TextBlock VerticalAlignment="Center" Margin="16 0 10 0" IsVisible="{Binding SelectedBotName, Converter={StaticResource isEmptyOrWhitespace}, ConverterParameter=invert}">
        Enabled:
      </TextBlock>
      <ComboBox
        SelectedValue="{Binding IsEnabled, Converter={StaticResource yesNoBooleanDisplayConverter}}"
        Initialized="ComboBox_Initialized"
        VerticalAlignment="Center"
        ItemsSource="{Binding Source={x:Static converters:YesNoBooleanDisplayConverter.NoYesOptionBooleans}, Converter={StaticResource yesNoBooleanDisplayConverter}}"
        IsVisible="{Binding SelectedBotName, Converter={StaticResource isEmptyOrWhitespace}, ConverterParameter=invert}"
        />
      <TextBlock VerticalAlignment="Center" Margin="16 0 10 0" IsVisible="{Binding SelectedBotName, Converter={StaticResource isEmptyOrWhitespace}, ConverterParameter=invert}">
        Nickname:
      </TextBlock>
      <TextBox
        Text="{Binding Nickname}"
        Width="125"
        IsVisible="{Binding SelectedBotName, Converter={StaticResource isEmptyOrWhitespace}, ConverterParameter=invert}"
        />
    </StackPanel>
    <Border IsVisible="{Binding SelectedBotName, Converter={StaticResource isEmptyOrWhitespace}, ConverterParameter=invert}" Margin="8 0 58 0" BorderBrush="DarkGoldenrod" BorderThickness="0 0 0 2" Padding="8 8 8 0">
      <StackPanel Orientation="Horizontal">
        <TextBlock FontWeight="DemiBold" FontSize="16" Text="{Binding SelectedBot?.Name}" />
        <TextBlock FontWeight="DemiBold" FontSize="16" Text=" Actions" />
        <TextBlock Foreground="Green" IsVisible="{Binding SelectedBot?.IsEnabled}" Margin="4 0 0 1" FontSize="10" VerticalAlignment="Bottom" Text="Enabled" />
        <TextBlock Foreground="Yellow" IsVisible="{Binding !SelectedBot?.IsEnabled}" Margin="4 0 0 1" FontSize="10" VerticalAlignment="Bottom" Text="Not Enabled" />
      </StackPanel>
    </Border>
    <ItemsControl IsVisible="{Binding SelectedBotName, Converter={StaticResource isEmptyOrWhitespace}, ConverterParameter=invert}" ItemsSource="{Binding SelectedBot?.BotActions}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="0" LineSpacing="0" />
        </ItemsPanelTemplate>

      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="24 8 50 8" Width="250">
            <Border Margin="0 0 50 0" BorderBrush="DarkGoldenrod" BorderThickness="0 0 0 1" Padding="8 8 8 0">
              <TextBlock VerticalAlignment="Bottom" Text="{Binding Name}" />
            </Border>
            <TextBlock IsVisible="{Binding !!Parameters.Count}" VerticalAlignment="Bottom" FontStyle="Oblique" FontSize="14" Margin="2" Padding="15 0" Text="Arguments:" />
            <TextBlock IsVisible="{Binding !Parameters.Count}" VerticalAlignment="Bottom" FontStyle="Oblique" FontSize="14" Margin="2" Padding="15 0" Text="(takes no arguments)" />
            <ItemsRepeater IsVisible="{Binding !!Parameters.Count}" ItemsSource="{Binding Parameters}" VerticalAlignment="Bottom">
              <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Bottom" FontStyle="Oblique" FontSize="14" Text="{Binding Name}" Margin="2" Padding="15 0" />
                  </StackPanel>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
