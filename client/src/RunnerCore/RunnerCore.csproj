<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MacroPad\MacroPad.csproj" />
    <ProjectReference Include="..\Configuration\Configuration.csproj" />
    <ProjectReference Include="..\BotConnections\BotConnections.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModuloFivePadClient.RunnerCore</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CS1030 is the #warning directive -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CS1030 is the #warning directive -->
    <WarningsNotAsErrors>CS1030</WarningsNotAsErrors>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
</Project>